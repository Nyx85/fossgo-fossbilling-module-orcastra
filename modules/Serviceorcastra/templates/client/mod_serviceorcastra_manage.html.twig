{% if order.status == 'active' %}
{% set service = client.serviceorcastra_get({ order_id: order.id }) %}
<div class="card mb-4">
    <div class="card-header">
        <h2>{{ 'Kelola Instance Orcastra'|trans }}</h2>
    </div>
    <div class="card-body">
        <table class="table table-striped table-bordered table-sm mb-4">
            <tbody>
                <tr><td>{{ 'Instance'|trans }}</td><td>{{ service.instance_name|default('—') }}</td></tr>
                <tr><td>{{ 'Cluster'|trans }}</td><td>{{ service.cluster_id|default('—') }}</td></tr>
                <tr><td>{{ 'Project'|trans }}</td><td>{{ service.project|default('default') }}</td></tr>
                <tr><td>{{ 'Tipe'|trans }}</td><td>{{ service.instance_type|default('—') }}</td></tr>
                <tr><td>{{ 'Status'|trans }}</td><td>{{ service.status|default('—') }}</td></tr>
            </tbody>
        </table>

        <div class="d-flex flex-wrap gap-2">
            <form method="post" action="{{ 'serviceorcastra/start'|api_url }}" {{ fb_api_form({message: 'Instance dimulai'|trans, reload: true}) }}>
                <input type="hidden" name="order_id" value="{{ order.id }}">
                <button class="btn btn-success" type="submit">{{ 'Mulai'|trans }}</button>
            </form>
            <form method="post" action="{{ 'serviceorcastra/stop'|api_url }}" {{ fb_api_form({message: 'Instance di-stop'|trans, reload: true}) }}>
                <input type="hidden" name="order_id" value="{{ order.id }}">
                <button class="btn btn-warning" type="submit">{{ 'Stop'|trans }}</button>
            </form>
            <form method="post" action="{{ 'serviceorcastra/restart'|api_url }}" {{ fb_api_form({message: 'Instance di-restart'|trans, reload: true}) }}>
                <input type="hidden" name="order_id" value="{{ order.id }}">
                <button class="btn btn-secondary" type="submit">{{ 'Restart'|trans }}</button>
            </form>
            <a class="btn btn-outline-primary" href="{{ 'serviceorcastra/console_url'|api_url(query: { order_id: order.id }) }}" {{ fb_api_link({callback: 'onOrcastraClientRedirect'}) }}>{{ 'Konsol'|trans }}</a>
            <a class="btn btn-outline-primary" href="{{ 'serviceorcastra/terminal_url'|api_url(query: { order_id: order.id }) }}" {{ fb_api_link({callback: 'onOrcastraClientRedirect'}) }}>{{ 'Terminal'|trans }}</a>
        </div>
        <p class="text-secondary small mt-3 mb-0">{{ 'Konsol/Terminal membuka sesi ber-tiket dari server. Jangan bookmark URL tanpa ticket=.'|trans }}</p>
    </div>
</div>
<script>
window.onOrcastraClientRedirect = function (result) {
    if (result && result.redirect_url) {
        window.open(result.redirect_url, '_blank', 'noopener');
    }
};
</script>
{% endif %}
